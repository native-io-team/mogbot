{
  "name": "@shipstudio/companion-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-widgets",
          "@expo/ui"
        ]
      }
    }
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@shipstudio/companion-protocol": "link:../packages/companion-protocol",
    "expo": "~58.0.23",
    "expo-app-intents": "0.5.16",
    "expo-application": "~58.1.2",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-quick-actions": "6.0.2",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-share-intent": "9.0.0",
    "expo-sharing": "~58.0.22",
    "expo-speech": "~58.0.3",
    "expo-speech-recognition": "58.0.1",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "expo-widgets": "~58.0.27",
    "marked": "^18.1.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/ws": "^8.18.2",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.14",
    "react-dom": "19.3.0",
    "react-native-web": "~0.21.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "ws": "^8.22.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "mock": "tsx dev/mock.ts",
    "qa:web": "node scripts/qa-web.mjs",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "../node_modules/.bin/eslint src dev __tests__"
  },
  "private": true,
  "jest": {
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo/ios",
        "testMatch": [
          "<rootDir>/__tests__/**/*.test.{ts,tsx}"
        ],
        "testPathIgnorePatterns": [
          "\\.node\\.test\\.ts$"
        ],
        "transformIgnorePatterns": [
          "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|marked|@noble/.*))"
        ],
        "moduleNameMapper": {
          "^\\./agentKeyPackShards$": "<rootDir>/__tests__/agentKeyPackShards.stub.ts"
        }
      },
      {
        "displayName": "node",
        "preset": "jest-expo/node",
        "testMatch": [
          "<rootDir>/__tests__/**/*.node.test.ts"
        ],
        "transformIgnorePatterns": [
          "node_modules/(?!(@noble/.*))"
        ],
        "moduleNameMapper": {
          "^\\./agentKeyPackShards$": "<rootDir>/__tests__/agentKeyPackShards.stub.ts"
        }
      }
    ]
  }
}
