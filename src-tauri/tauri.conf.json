{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mogbot",
  "version": "../package.json",
  "identifier": "io.native.mogbot",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/ShipStudio/**/*.png",
          "$HOME/ShipStudio/**/*.PNG",
          "$HOME/ShipStudio/**/*.jpg",
          "$HOME/ShipStudio/**/*.JPG",
          "$HOME/ShipStudio/**/*.jpeg",
          "$HOME/ShipStudio/**/*.JPEG",
          "$HOME/ShipStudio/**/*.gif",
          "$HOME/ShipStudio/**/*.GIF",
          "$HOME/ShipStudio/**/*.webp",
          "$HOME/ShipStudio/**/*.WEBP",
          "$HOME/ShipStudio/**/*.avif",
          "$HOME/ShipStudio/**/*.AVIF",
          "$HOME/ShipStudio/**/*.svg",
          "$HOME/ShipStudio/**/*.SVG",
          "$HOME/ShipStudio/**/*.ico",
          "$HOME/ShipStudio/**/*.ICO",
          "$HOME/ShipStudio/**/*.bmp",
          "$HOME/ShipStudio/**/*.BMP",
          "$HOME/ShipStudio/**/*.tif",
          "$HOME/ShipStudio/**/*.TIF",
          "$HOME/ShipStudio/**/*.tiff",
          "$HOME/ShipStudio/**/*.TIFF"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "fonts/*": "fonts/",
      "resources/scrcpy-server.jar": "scrcpy-server.jar",
      "../chrome-extension/extension/": "chrome-extension/"
    },
    "createUpdaterArtifacts": false,
    "macOS": {
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "mogbot"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEMDUzMzQ2ODY5MkRENDEKUldSQjNaS0dSak1GUFV4QnM0clJTb2FrL3ZaNXViMmp6V25YTkJ6MzdUV0NDZlR0MmFrQ3N2U2gK",
      "endpoints": [
        "https://github.com/native-io-team/mogbot-releases/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
