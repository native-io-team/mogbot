// Mogbot's push relay, deployed to Julian's Cloudflare account (see
// docs/push-relay.md). Forks: replace the name, topic and database id.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mogbot-push-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // No Workers Logs: the relay prints nothing about who or what, and keeps
  // no request logs of its own.
  "observability": { "enabled": false },
  "vars": {
    // The official phone app's bundle id (brand.json companion.bundleId).
    "APNS_TOPIC": "io.native.mogbot.companion"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mogbot-push",
      "database_id": "df278138-fdee-4bce-a7d2-30f774813162",
      "migrations_dir": "migrations"
    }
  ],
  // Creating an installation is the one unauthenticated route. Cloudflare's
  // limiter counts it per client address; the relay never stores one.
  "ratelimits": [
    {
      "name": "CREATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
  // Secrets (`wrangler secret put <NAME>`), never in this file:
  //   APNS_KEY      the .p8 file's contents
  //   APNS_KEY_ID   the key's 10-character id
  //   APNS_TEAM_ID  the Apple team id that owns the bundle id
  //   FCM_SERVICE_ACCOUNT  optional, Android: the service account JSON
}
