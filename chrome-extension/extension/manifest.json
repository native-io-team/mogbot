{
  "manifest_version": 3,
  "name": "Mogbot for Chrome",
  "short_name": "Mogbot",
  "version": "0.1.0",
  "description": "Lets your Mogbot agents use this Chrome, through the Mogbot app on your Mac. Every send, post or payment asks you first.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["nativeMessaging", "debugger", "tabs", "tabGroups", "storage", "alarms"],
  "background": {
    "service_worker": "src/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Mogbot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
